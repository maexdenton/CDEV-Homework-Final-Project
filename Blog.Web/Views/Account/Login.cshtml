@model Blog.Web.ViewModels.LoginViewModel

@{
    ViewData["Title"] = "Вход в систему";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="card-title text-center mb-4 fw-bold">Вход</h2>

                <form asp-action="Login" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <input asp-for="Email" class="form-control" placeholder="name@example.com" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <!-- Пароль по умолчанию скрыт; кнопка-глаз позволяет пользователю проверить ввод перед отправкой и снижает риск опечатки. -->
                    <div class="mb-3">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <input asp-for="Password" type="password" id="passwordInput" class="form-control" placeholder="Ваш пароль" />
                            <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn"
                                    onclick="togglePasswordVisibility('passwordInput', 'passwordIcon')"
                                    tabindex="-1" title="Показать/скрыть пароль">
                                <i class="bi bi-eye" id="passwordIcon"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mt-3 fw-semibold">Войти</button>

                    <div class="text-center mt-3">
                        <span class="text-muted">Нет учетной записи?</span>
                        <a asp-action="Register" class="text-decoration-none">Зарегистрироваться</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // Переключает видимость пароля. Вынесено в отдельную функцию, чтобы одна и та же логика
        // могла использоваться на нескольких полях (сейчас — на странице входа, но функция
        // подходит и для форм регистрации/смены пароля).
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);

            // Защита от несовпадения id в разметке и вызове: без нее отсутствие элемента
            // привело бы к ошибке в консоли, не влияя на работу формы.
            if (!input || !icon) return;

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
