@model Blog.Web.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Смена пароля";
}

<!-- Подключение Bootstrap Icons для иконки глаза -->
<!-- <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" /> -->

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <h2 class="text-center mb-4">Смена пароля</h2>
                    
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <!-- Поле "Текущий пароль" с кнопкой переключения видимости -->
                        <div class="mb-3">
                            <label asp-for="CurrentPassword" class="form-label fw-semibold">Текущий пароль</label>
                            <div class="input-group">
                                <input asp-for="CurrentPassword" type="password" id="currentPasswordInput" class="form-control" placeholder="Введите текущий пароль" />
                                <button class="btn btn-outline-secondary" type="button" id="toggleCurrentPasswordBtn"
                                        onclick="togglePasswordVisibility('currentPasswordInput', 'currentPasswordIcon')"
                                        tabindex="-1" title="Показать/скрыть пароль">
                                    <i class="bi bi-eye" id="currentPasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
                        </div>

                        <!-- Поле "Новый пароль" с кнопкой переключения видимости -->
                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-semibold">Новый пароль</label>
                            <div class="input-group">
                                <input asp-for="NewPassword" type="password" id="newPasswordInput" class="form-control" placeholder="Минимум 6 знаков" />
                                <button class="btn btn-outline-secondary" type="button" id="toggleNewPasswordBtn"
                                        onclick="togglePasswordVisibility('newPasswordInput', 'newPasswordIcon')"
                                        tabindex="-1" title="Показать/скрыть пароль">
                                    <i class="bi bi-eye" id="newPasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <!-- Поле "Подтверждение пароля" с идентичной кнопкой -->
                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold">Подтверждение пароля</label>
                            <div class="input-group">
                                <input asp-for="ConfirmPassword" type="password" id="confirmPasswordInput" class="form-control" placeholder="Повторите пароль" />
                                <button class="btn btn-outline-secondary" type="button" id="toggleConfirmPasswordBtn"
                                        onclick="togglePasswordVisibility('confirmPasswordInput', 'confirmPasswordIcon')"
                                        tabindex="-1" title="Показать/скрыть пароль">
                                    <i class="bi bi-eye" id="confirmPasswordIcon"></i>
                                </button>
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-primary">Сменить пароль</button>
                            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        function togglePasswordVisibility(inputId, iconId) {
            const input = document.getElementById(inputId);
            const icon = document.getElementById(iconId);
            
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('bi-eye');
                icon.classList.add('bi-eye-slash');
            } else {
                input.type = 'password';
                icon.classList.remove('bi-eye-slash');
                icon.classList.add('bi-eye');
            }
        }
    </script>
}
