@using Microsoft.AspNetCore.Identity
@using Blog.DAL.Entities
@using Blog.BLL.Security
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blog Engine</title>
    
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <!-- Bootstrap Icons нужен для иконок «Глаз» (пароль) и уведомлений (check/exclamation) в этой и других разметках. -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />
    
    <style>
        /* Предотвращает горизонтальные скачки верстки при появлении/исчезновении полосы прокрутки. */
        html {
            overflow-y: scroll;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Прижимает футер к низу экрана, забирая все свободное пространство. */
        .main-content {
            flex: 1 0 auto;
        }

        /* Фиксирует высоту футера, чтобы она не менялась при переходах между страницами. */
        .site-footer {
            flex-shrink: 0;
            height: 60px;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Blog Engine</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    
                    <ul class="navbar-nav me-auto">
                        @if (User.IsInRole(AppRoles.Administrator))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Администрирование
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-controller="Users" asp-action="Index">Пользователи</a></li>
                                    <li><a class="dropdown-item" asp-controller="Roles" asp-action="Index">Роли</a></li>
                                </ul>
                            </li>
                        }
                    </ul>

                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            // Имя показываем из профиля (FirstName/LastName), а если они пусты — логин из Identity.
                            var currentUser = await UserManager.GetUserAsync(User);
                            var displayName = (currentUser != null && (!string.IsNullOrWhiteSpace(currentUser.FirstName) || !string.IsNullOrWhiteSpace(currentUser.LastName)))
                                ? $"{currentUser.FirstName} {currentUser.LastName}".Trim()
                                : User.Identity.Name;

                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-light" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Привет, <strong>@displayName</strong>!
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                    <li>
                                        <a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Сменить пароль</a>
                                    </li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="dropdown-item text-danger">Выход</button>
                                        </form>
                                    </li>
                                </ul>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-2" asp-controller="Account" asp-action="Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container main-content pb-4">
        
        @* Сообщения из TempData показываются один раз после редиректа — это стандартный паттерн PRG. *@
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show mt-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top site-footer text-muted bg-white text-center">
        <div class="container">
            &copy; @DateTime.Now.Year - Blog Engine
        </div>
    </footer>

    <!-- Bootstrap JS нужен для работы выпадающих меню и закрытия уведомлений по крестику. -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Секция Scripts: сюда представления добавляют валидацию и JS «Глаз» для пароля. -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
