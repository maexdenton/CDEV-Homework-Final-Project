@using Microsoft.AspNetCore.Identity
@using Blog.DAL.Entities
@inject UserManager<User> UserManager

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Blog Engine</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    
    <style>
        /* Предотвращает скачки верстки по горизонтали при появлении/исчезновении полосы прокрутки */
        html {
            overflow-y: scroll;
        }

        /* Растягиваем body на всю высоту экрана через Flexbox */
        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* Основной контент забирает все свободное пространство, прижимая футер к низу */
        .main-content {
            flex: 1 0 auto;
        }

        /* Жесткая фиксация высоты футера без изменений при переходах */
        .site-footer {
            flex-shrink: 0;
            height: 60px;
            box-sizing: border-box;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
            <div class="container">
                <!-- Cсылка на главную страницу -->
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">Blog Engine</a>
                
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>
                
                <div class="collapse navbar-collapse" id="navbarContent">
                    <div class="me-auto"></div>

                    <!-- Правая часть: авторизация / профиль -->
                    <ul class="navbar-nav align-items-center">
                        @if (User.Identity?.IsAuthenticated ?? false)
                        {
                            // Получаем данные текущего пользователя для вывода Имени и Фамилии
                            var currentUser = await UserManager.GetUserAsync(User);
                            var displayName = (currentUser != null && (!string.IsNullOrWhiteSpace(currentUser.FirstName) || !string.IsNullOrWhiteSpace(currentUser.LastName)))
                                ? $"{currentUser.FirstName} {currentUser.LastName}".Trim()
                                : User.Identity.Name;

                            <li class="nav-item">
                                <span class="nav-link text-light me-2">
                                    Привет, <strong>@displayName</strong>!
                                </span>
                            </li>
                            <li class="nav-item">
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-light btn-sm">Выход</button>
                                </form>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Account" asp-action="Login">Вход</a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-primary btn-sm ms-2" asp-controller="Account" asp-action="Register">Регистрация</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <!-- Обертка основного контента страницы -->
    <div class="container main-content pb-4">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- Зафиксируем футер -->
    <footer class="border-top site-footer text-muted bg-white text-center">
        <div class="container">
            &copy; 2026 - Blog Engine
        </div>
    </footer>

    <!-- Скрипты Bootstrap -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Секция скриптов для представлений -->
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
