@using Blog.BLL.Security
@model IEnumerable<Blog.Web.ViewModels.RoleListViewModel>
@{
    ViewData["Title"] = "Управление ролями";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Системные роли</h2>
    </div>

    <div class="alert alert-info">
        <i class="bi bi-info-circle"></i> В системе используются только три предустановленные роли. Создание или удаление ролей недоступно.
    </div>

    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Название роли</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var role in Model)
            {
                bool isSystemRole = role.Name == AppRoles.Administrator || 
                                    role.Name == AppRoles.Moderator || 
                                    role.Name == AppRoles.User;
                
                <tr>
                    <td>@role.Name</td>
                    <td>
                        <a asp-action="Details" asp-route-id="@role.Id" class="btn btn-sm btn-info">Детали</a>
                        
                        @if (!isSystemRole)
                        {
                            <a asp-action="Edit" asp-route-id="@role.Id" class="btn btn-sm btn-warning">Изменить</a>
                            <a asp-action="Delete" asp-route-id="@role.Id" class="btn btn-sm btn-danger">Удалить</a>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
