@model ArticleDetailsPageViewModel

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <h1 class="card-title">@Model.Article.Title</h1>
        <p class="text-muted">Автор: @Model.Article.AuthorFullName | @Model.Article.CreatedAt.ToLocalTime().ToString("f")</p>
        <div class="my-3 lead" style="white-space: pre-wrap;">@Model.Article.Content</div>
        <div>
            @foreach (var tag in Model.Article.Tags)
            {
                <span class="badge bg-info text-dark">#@tag</span>
            }
        </div>
    </div>
</div>

<h3>Комментарии</h3>
@if (User.Identity?.IsAuthenticated ?? false)
{
    <form asp-action="AddComment" asp-route-articleId="@Model.Article.Id" method="post" class="mb-4">
        <div class="mb-3">
            <textarea asp-for="NewCommentContent" class="form-control" rows="3" placeholder="Оставьте комментарий..."></textarea>
            <span asp-validation-for="NewCommentContent" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-success">Отправить</button>
    </form>
}

<div class="list-group">
    @foreach (var comment in Model.Article.Comments)
    {
        <div class="list-group-item">
            <div class="d-flex justify-content-between">
                <strong>@comment.AuthorFullName</strong>
                <small class="text-muted">@comment.CreatedAt.ToLocalTime().ToString("g")</small>
            </div>
            <p class="mt-2 mb-0">@comment.Content</p>
        </div>
    }
</div>
