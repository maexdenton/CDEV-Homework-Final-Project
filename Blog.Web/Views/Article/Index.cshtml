@model ArticleIndexViewModel

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1>Публикации</h1>
    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <a asp-action="Create" class="btn btn-primary">+ Написать статью</a>
    }
</div>

<form method="get" class="row g-2 mb-4">
    <div class="col-md-9">
        <input type="text" name="search" value="@Model.SearchQuery" class="form-control" placeholder="Поиск по заголовку и содержимому..." />
    </div>
    <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-outline-secondary w-100">Найти</button>
        <a asp-action="Index" class="btn btn-outline-danger">Сброс</a>
    </div>
</form>

@if (!string.IsNullOrEmpty(Model.TagFilter))
{
    <div class="alert alert-secondary">Выбран тег: <strong>#@Model.TagFilter</strong></div>
}

<div class="row">
    @foreach (var article in Model.Articles)
    {
        <div class="col-md-12 mb-3">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h3 class="card-title"><a asp-action="Details" asp-route-id="@article.Id">@article.Title</a></h3>
                    <p class="text-muted">Автор: @article.AuthorFullName | @article.CreatedAt.ToLocalTime().ToString("g")</p>
                    <p class="card-text">@(article.Content.Length > 200 ? article.Content[..200] + "..." : article.Content)</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            @foreach (var tag in article.Tags)
                            {
                                <a asp-action="Index" asp-route-tag="@tag" class="badge bg-secondary text-decoration-none">#@tag</a>
                            }
                        </div>
                        <span class="text-muted">💬 Комментариев: @article.CommentsCount</span>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
