@model Blog.BLL.DTOs.ArticleDetailsDto

@{
    ViewData["Title"] = Model.Title;
}

<div class="mb-3">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Назад к списку статей</a>
</div>

<article class="card shadow-sm mb-4">
    <div class="card-body p-4">
        <h1 class="card-title display-6">@Model.Title</h1>
        <div class="text-muted small mb-4">
            Автор: <strong>@Model.AuthorFullName</strong> | Опубликовано: @Model.CreatedAt.ToLocalTime().ToString("f")
        </div>
        <div class="lead mb-4" style="white-space: pre-wrap; font-size: 1.15rem;">@Model.Content</div>
        <div>
            @foreach (var tag in Model.Tags)
            {
                <a asp-action="Index" asp-route-tag="@tag" class="badge bg-primary text-decoration-none">#@tag</a>
            }
        </div>
    </div>
</article>

<!-- Секция комментариев -->
<section class="card shadow-sm p-4 mb-5">
    <h3 class="h4 mb-3">Комментарии (@Model.Comments.Count)</h3>

    @if (User.Identity?.IsAuthenticated ?? false)
    {
        <form asp-action="AddComment" method="post" class="mb-4">
            <input type="hidden" name="articleId" value="@Model.Id" />
            <div class="mb-3">
                <textarea name="content" class="form-control" rows="3" placeholder="Оставьте ваш комментарий..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Отправить комментарий</button>
        </form>
    }
    else
    {
        <div class="alert alert-light border mb-4">
            Чтобы оставить комментарий, пожалуйста, <a asp-controller="Account" asp-action="Login">войдите</a> или <a asp-controller="Account" asp-action="Register">зарегистрируйтесь</a>.
        </div>
    }

    <div class="list-group list-group-flush">
        @foreach (var comment in Model.Comments)
        {
            <div class="list-group-item px-0 py-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <strong>@comment.AuthorFullName</strong>
                    <small class="text-muted">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <p class="mb-0 text-secondary">@comment.Content</p>
            </div>
        }
    </div>
</section>
