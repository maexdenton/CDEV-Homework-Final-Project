@model Blog.BLL.DTOs.ArticleDetailsDto
@using System.Security.Claims
@using Blog.BLL.Security

@{
    ViewData["Title"] = Model.Title;
    
    // Получение ID авторизованного пользователя и его прав
    var currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isElevated = User.IsInRole(AppRoles.Administrator) || User.IsInRole(AppRoles.Moderator);

    // Право на управление статьей: автор, администратор или модератор
    var canManageArticle = isAuthenticated && (Model.AuthorId == currentUserId || isElevated);
}

<!-- Уведомления об операциях -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm mb-4" role="alert">
        <span>✔ @TempData["SuccessMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm mb-4" role="alert">
        <span>⚠ @TempData["ErrorMessage"]</span>
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Закрыть"></button>
    </div>
}

<div class="mb-3 d-flex justify-content-between align-items-center">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">&larr; Назад ко всем статьям</a>

    @* Панель действий со статьей: видна только автору, модератору и администратору *@
    @if (canManageArticle)
    {
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm">
                ✏ Редактировать статью
            </a>

            <form asp-action="DeleteArticle" asp-route-id="@Model.Id" method="post" class="d-inline"
                  onsubmit="return confirm('Вы действительно хотите удалить эту статью? Это действие нельзя отменить.');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger btn-sm">
                    🗑 Удалить статью
                </button>
            </form>
        </div>
    }
</div>

<!-- Отображение статьи -->
<article class="card shadow-sm mb-4 border-0">
    <div class="card-body p-4">
        <h1 class="card-title display-6 fw-bold mb-3">@Model.Title</h1>

        <div class="text-muted small mb-4 pb-2 border-bottom d-flex justify-content-between align-items-center">
            <div>
                Автор: <strong>@Model.AuthorFullName</strong> &bull;
                Опубликовано: @Model.CreatedAt.ToLocalTime().ToString("f")
                @if (Model.UpdatedAt.HasValue)
                {
                    <span class="text-secondary ms-2">(обновлено: @Model.UpdatedAt.Value.ToLocalTime().ToString("g"))</span>
                }
            </div>
            @if (canManageArticle && Model.AuthorId != currentUserId)
            {
                <span class="badge bg-warning text-dark">Режим модерации</span>
            }
        </div>

        <div class="lead mb-4" style="white-space: pre-wrap; font-size: 1.15rem; line-height: 1.7;">@Model.Content</div>

        <div>
            @foreach (var tag in Model.Tags)
            {
                <a asp-action="Index" asp-route-tag="@tag" class="badge bg-primary text-decoration-none me-1">#@tag</a>
            }
        </div>
    </div>
</article>

<!-- Секция комментариев -->
<section class="card shadow-sm p-4 mb-5 border-0">
    <h3 class="h4 mb-3">Комментарии (@Model.Comments.Count)</h3>

    <!-- Форма отправки нового комментария -->
    @if (isAuthenticated)
    {
        <form asp-action="AddComment" method="post" class="mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="articleId" value="@Model.Id" />
            <div class="mb-3">
                <textarea name="content" class="form-control" rows="3" placeholder="Оставьте ваш комментарий..." required></textarea>
            </div>
            <button type="submit" class="btn btn-primary">Отправить комментарий</button>
        </form>
    }
    else
    {
        <div class="alert alert-light border mb-4">
            Чтобы оставить комментарий, <a asp-controller="Account" asp-action="Login">войдите</a> или <a asp-controller="Account" asp-action="Register">зарегистрируйтесь</a>.
        </div>
    }

    <!-- Список существующих комментариев -->
    <div class="list-group list-group-flush">
        @foreach (var comment in Model.Comments)
        {
            // Право на управление комментарием: автор комментария, администратор или модератор
            var canManageComment = isAuthenticated && (comment.AuthorId == currentUserId || isElevated);

            <div class="list-group-item px-0 py-3" id="comment-container-@comment.Id">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <div>
                        <strong class="text-dark">@comment.AuthorFullName</strong>
                        <small class="text-muted ms-2">@comment.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                    </div>

                    @* Кнопки управления комментарием *@
                    @if (canManageComment)
                    {
                        <div class="btn-group btn-group-sm">
                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="toggleCommentEdit(@comment.Id)">
                                ✏ Редактировать
                            </button>
                            <form asp-action="DeleteComment" method="post" class="d-inline"
                                  onsubmit="return confirm('Вы уверены, что хотите удалить этот комментарий?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="commentId" value="@comment.Id" />
                                <input type="hidden" name="articleId" value="@Model.Id" />
                                <button type="submit" class="btn btn-outline-danger btn-sm ms-1">
                                    🗑 Удалить
                                </button>
                            </form>
                        </div>
                    }
                </div>

                <!-- Режим 1: Обычный просмотр комментария -->
                <div id="comment-view-@comment.Id">
                    <p class="mb-0 text-secondary" style="white-space: pre-wrap;">@comment.Content</p>
                </div>

                <!-- Режим 2: Инлайн-форма редактирования (скрыта по умолчанию) -->
                @if (canManageComment)
                {
                    <div id="comment-edit-@comment.Id" class="d-none mt-2">
                        <form asp-action="EditComment" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="commentId" value="@comment.Id" />
                            <input type="hidden" name="articleId" value="@Model.Id" />

                            <div class="mb-2">
                                <textarea name="content" id="comment-textarea-@comment.Id" class="form-control" rows="3" required>@comment.Content</textarea>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" class="btn btn-success btn-sm">💾 Сохранить</button>
                                <button type="button" class="btn btn-secondary btn-sm" onclick="cancelCommentEdit(@comment.Id)">❌ Отмена</button>
                            </div>
                        </form>
                    </div>
                }
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>
        function toggleCommentEdit(id) {
            const viewBlock = document.getElementById('comment-view-' + id);
            const editBlock = document.getElementById('comment-edit-' + id);

            if (viewBlock && editBlock) {
                viewBlock.classList.toggle('d-none');
                editBlock.classList.toggle('d-none');
            }
        }

        function cancelCommentEdit(id) {
            const viewParagraph = document.querySelector('#comment-view-' + id + ' p');
            const textarea = document.getElementById('comment-textarea-' + id);

            // Восстанавливаем оригинальный текст комментария из блока просмотра
            if (viewParagraph && textarea) {
                textarea.value = viewParagraph.textContent;
            }
            toggleCommentEdit(id);
        }
    </script>
}
