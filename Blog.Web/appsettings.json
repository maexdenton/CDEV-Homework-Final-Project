{
  // Строка подключения к БД для production задавайте через переменные окружения или секреты,
  // а не храните в репозитории.
  "ConnectionStrings": {
    "DefaultConnection": "Server=.\\SQLEXPRESS;Database=Blog3TierDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Serilog": {
    // Минимальные уровни логирования. Сторонние библиотеки (Microsoft.*) ограничены Warning,
    // чтобы не засорять лог техническими сообщениями фреймворка.
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    // Куда писать логи: консоль и файл с суточной ротацией.
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/blog-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30,
          // Шаблон включает контекст пользователя (UserName, UserRoles, ClientIp),
          // который добавляется middleware UserContextLoggingMiddleware.
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] [{SourceContext}] [User: {UserName}] [Roles: {UserRoles}] [IP: {ClientIp}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    // Обогащение логов: контекст (из LogContext), имя машины и ID потока.
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  // Ограничение принимаемых хостов (для production надо указать конкретные домены вместо "*").
  "AllowedHosts": "*"
}
